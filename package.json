{
	"name": "matchimus",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"description": "A beautiful memory card game with emoji cards and multiple themes",
	"keywords": [
		"memory-game",
		"react",
		"typescript",
		"tailwindcss",
		"emoji"
	],
	"author": "Ellie",
	"license": "MIT",
	"scripts": {
		"dev": "vite --mode emulator",
		"build": "tsc -b && vite build --mode emulator",
		"lint": "eslint . --max-warnings 0",
		"preview": "vite preview",
		"test": "vitest",
		"test:run": "vitest run",
		"dev:local": "bun scripts/local.ts dev",
		"build:production": "tsc -b && vite build --mode production",
		"typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p tsconfig.server.json",
		"check": "bun run lint && bun run typecheck && bun run test:run && bun run test:server",
		"test:coverage": "vitest run --coverage",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:e2e": "playwright test",
		"verify:local": "bun scripts/local.ts verify",
		"start": "bun server/index.ts",
		"test:server": "vitest run --config vitest.server.config.ts",
		"test:ingest-runtime": "bun scripts/test-ingest-runtime.ts",
		"test:container": "bun scripts/container.ts all",
		"build:container": "bun scripts/container.ts build",
		"test:container:image": "bun scripts/container.ts test",
		"verify:release": "bun scripts/local.ts release"
	},
	"dependencies": {
		"@fastify/static": "10.1.4",
		"@tanstack/react-router": "^1.90.0",
		"@types/canvas-confetti": "^1.9.0",
		"canvas-confetti": "^1.9.4",
		"dexie": "^4.2.1",
		"fastify": "5.12.5",
		"firebase": "^12.6.0",
		"lucide-react": "^0.556.0",
		"posthog-js": "^1.302.2",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"screenfull": "^6.0.2",
		"zustand": "^5.0.9"
	},
	"devDependencies": {
		"@eslint/js": "^9.36.0",
		"@playwright/test": "1.63.0",
		"@tanstack/router-devtools": "^1.90.0",
		"@tanstack/router-plugin": "^1.141.7",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "14.6.7",
		"@types/node": "^24.6.0",
		"@types/react": "^19.1.16",
		"@types/react-dom": "^19.1.9",
		"@vitejs/plugin-react": "^5.0.4",
		"@vitest/coverage-v8": "4.0.15",
		"autoprefixer": "^10.4.21",
		"eslint": "^9.36.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.22",
		"firebase-tools": "15.30.2",
		"globals": "^16.4.0",
		"jsdom": "^27.3.0",
		"postcss": "^8.5.6",
		"prettier": "3.6.2",
		"tailwindcss": "3",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.45.0",
		"vite": "^6.0.1",
		"vitest": "^4.0.15"
	},
	"packageManager": "bun@1.3.9",
	"engines": {
		"node": ">=24 <25",
		"bun": "1.3.9"
	}
}
